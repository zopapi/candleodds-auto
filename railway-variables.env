# Paste into Railway -> worker service -> Variables -> Raw Editor, then replace the <PLACEHOLDERS>. For a manual deploy only (the template sets these itself): OPERATOR-GUIDE.md section 4b.3.
# Never commit real values (this file holds none).

# --- secrets and identity: replace these three (DATABASE_URL is a reference to the Postgres service) ---
CANDLEODDS_TOKEN=<YOUR_cot_TOKEN>
AUTOTRADE_EXPECTED_WALLET=<YOUR_TRADING_WALLET_ADDRESS>
WALLET_PRIVATE_KEY=<YOUR_EXPORTED_KEY>
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- pilot values (leave as they are) ---
# Starts in shadow mode (no real orders). Go live only after the logs look right: set AUTOTRADE_MODE=live and add
# AUTOTRADE_LIVE_CONFIRM=yes-place-real-orders (OPERATOR-GUIDE.md section 6).
AUTOTRADE_MODE=shadow
AUTOTRADE_EXECUTION=taker
ENTRY_MIN_CENTS=0
ENTRY_MAX_CENTS=60
AUTOTRADE_STAKE_USD=5
AUTOTRADE_MAX_STAKE_USD=5
AUTOTRADE_DAILY_LOSS_LIMIT_USD=100
AUTOTRADE_MAX_TRADES_PER_DAY=50
# Re-entry (taker): an ask above ENTRY_MAX_CENTS at decision time is watched until this many seconds after open. 0 = off.
AUTOTRADE_REENTRY_UNTIL_SECONDS=480
CANDLEODDS_URL=https://www.candleodds.com
